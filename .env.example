# ════════════════════════════════════════════════════════════════════════════
# CHECADOR DE ASISTENCIA — Backend Variables de Entorno
# ════════════════════════════════════════════════════════════════════════════
# INSTRUCCIONES:
#   1. Copia este archivo como ".env" dentro de backend/
#   2. Rellena cada valor con datos reales y seguros de tu infraestructura
#   3. NUNCA subas el archivo .env a Git — verificado en .gitignore
# ════════════════════════════════════════════════════════════════════════════

# ─── Servidor y Reverse Proxy ─────────────────────────────────────────────────
PORT=8080
SERVER_PORT=8080

# ─── Base de Datos MySQL (Aiven / Local / Docker) ──────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=checador_db
DB_USERNAME=avnadmin
# Contraseña obligatoria sin default inseguro:
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_EN_PRODUCCION
DB_USE_SSL=true

# ─── JWT (JSON Web Token) ─────────────────────────────────────────────────────
# Genera una clave segura de mínimo 256 bits con: openssl rand -base64 64
JWT_SECRET=CAMBIAR_POR_CLAVE_BASE64_SEGURA_MIN_256_BITS
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ─── JPA / Hibernate ─────────────────────────────────────────────────────────
# "validate" para producción; "update" solo en entornos de desarrollo local
JPA_DDL_AUTO=validate

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://mi-empresa-checador.onrender.com,http://localhost:3000

# ─── Superadministrador Inicial ───────────────────────────────────────────────
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_SUPERADMIN_SEGURA
SUPERADMIN_EMAIL=superadmin@example.com

# ─── Claves de Tareas Programadas (Cron) ──────────────────────────────────────
CRON_API_KEY=CAMBIAR_POR_TOKEN_CRON_SECRETO_AL_MENOS_32_CARACTERES

# ─── Notificaciones Push Web (VAPID) ──────────────────────────────────────────
VAPID_PUBLIC_KEY=BDUMMY_PUBLIC_KEY_REPLACE_WITH_REAL_GENERATED_VAPID_KEY_AAAA
VAPID_PRIVATE_KEY=DUMMY_PRIVATE_KEY_REPLACE_WITH_REAL_GENERATED_VAPID_KEY_BBBB
VAPID_SUBJECT=mailto:admin@example.com

# ─── Correo Electrónico (SMTP) ────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@example.com
MAIL_PASSWORD=CAMBIAR_POR_APP_PASSWORD_SMTP
MAIL_FROM=notificaciones@example.com

# ─── Documentación OpenAPI / Swagger ──────────────────────────────────────────
SWAGGER_ENABLED=false

# ─── Asistencia y Tolerancia ──────────────────────────────────────────────────
ATTENDANCE_TOLERANCE_MINUTES=10

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN
